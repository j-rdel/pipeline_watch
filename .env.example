# --- LLM (Ollama local) ---
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.2

# --- GitHub (leave empty to run in fixture mode) ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Discord (leave empty to run in dry-run mode) ---
DISCORD_WEBHOOK_URL=

# --- Storage / RAG ---
PW_DB_PATH=.cache/incidents.sqlite
PW_INDEX_PATH=.cache/runbook.faiss

# --- Observability ---
PW_LOG_LEVEL=INFO
PW_OTEL_EXPORTER=console  # console | otlp
# PW_OTLP_ENDPOINT=http://localhost:4317

# --- Safety ---
PW_DRY_RUN=true             # if true, never opens PRs or posts to Discord
PW_ALLOWLIST_PATHS=.github/workflows/,requirements.txt,pyproject.toml,uv.lock
