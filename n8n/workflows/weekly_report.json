{
  "name": "pipeline_watch — weekly report to Discord",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "cron-mon-9am",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PIPELINE_WATCH_URL }}/reports/weekly?limit=5",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-weekly",
      "name": "GET /reports/weekly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.first().json.top_signatures || [];\nconst total = $input.first().json.total_runs_7d;\n\nif (items.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nconst rows = items\n  .map((s, i) => `${i + 1}. **${s.error_signature}** — ${s.n} hits (last: ${s.last_seen.slice(0, 10)})`)\n  .join('\\n');\n\nconst embed = {\n  embeds: [\n    {\n      title: '🗓️  pipeline_watch weekly report',\n      description: `**${total}** failure incidents recorded in the last 7 days.`,\n      color: 0x3498db,\n      fields: [\n        { name: 'Top failure signatures', value: rows, inline: false }\n      ],\n      footer: { text: 'Generated by pipeline_watch via n8n' }\n    }\n  ]\n};\n\nreturn [{ json: embed }];"
      },
      "id": "build-embed",
      "name": "Build Discord embed",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip === true }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "id": "skip-if-empty",
      "name": "Skip if no data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "post-discord",
      "name": "POST to Discord webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 380]
    }
  ],
  "connections": {
    "Every Monday 09:00": {
      "main": [[{ "node": "GET /reports/weekly", "type": "main", "index": 0 }]]
    },
    "GET /reports/weekly": {
      "main": [[{ "node": "Build Discord embed", "type": "main", "index": 0 }]]
    },
    "Build Discord embed": {
      "main": [[{ "node": "Skip if no data", "type": "main", "index": 0 }]]
    },
    "Skip if no data": {
      "main": [
        [],
        [{ "node": "POST to Discord webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "pipeline_watch-weekly-v1",
  "meta": {
    "instanceId": "pipeline_watch-demo"
  },
  "tags": []
}
